                  "videoUrl": "https://www.youtube.com/watch?v=dQqApCGd5Ss"
                },
                {
                  "id": "la-ext",
                  "name": "Leg extension (from ~90 degrees to straight)",
                  "sets": 3,
                  "reps": 12,
                  "description": "Graft is mature, so full lockout is OK. Start light, 2-sec squeeze at top, 3-sec lowering. Add weight slowly. Back off if deep knee pain goes above 3/10",
